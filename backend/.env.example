# MySQL connection string (database name must be Skillable)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/Skillable

# Change this in production
SECRET_KEY=change-me-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional but recommended: set a stable Fernet key for encrypting sensitive profile fields.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Comma-separated list. Use * to allow all.
CORS_ORIGINS=http://localhost:3000

# Chatbot provider. Use gemini, agentrouter, or openrouter.
CHAT_PROVIDER=gemini
CHAT_MODEL=deepseek-v4-flash
CHAT_TIMEOUT_SECONDS=60
# Optional: set to your Wi-Fi IP if VPN/proxy routing blocks agentrouter.org.
# Example on macOS: ipconfig getifaddr en0
CHAT_BIND_LOCAL_ADDRESS=

# Gemini setup. Never commit a real API key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-flash-latest

# AgentRouter setup. Never commit a real API key.
AGENTROUTER_API_KEY=sk_your_agentrouter_key
AGENTROUTER_URL=https://agentrouter.org/v1/chat/completions
AGENTROUTER_ORIGINATOR=codex_cli_rs
AGENTROUTER_USER_AGENT=codex_cli_rs/0.101.0 (Mac OS 26.0.1; arm64) Apple_Terminal/464
AGENTROUTER_VERSION=0.101.0

# Optional fallback if CHAT_PROVIDER=openrouter. Never commit a real API key.
OPENROUTER_API_KEY=sk-or-your_openrouter_key
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Skillable
